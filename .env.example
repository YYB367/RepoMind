# V1.1 goal: extract source-grounded facts with DeepSeek; keep V1 temporal rules.
# Copy this file to .env in this directory. The CLI reads it automatically.
# Paste your real key only after the equals sign below. Never commit .env.
DEEPSEEK_API_KEY=
REPOMIND_PROVIDER=deepseek
REPOMIND_BASE_URL=https://api.deepseek.com
REPOMIND_CHAT_MODEL=deepseek-flash
REPOMIND_CHAT_FORMAT=json_object
REPOMIND_TIMEOUT_SECONDS=60

# Optional: a SEPARATE embedding service. DeepSeek's current API reference does
# not list an embeddings endpoint. Leave these blank to use lexical search.
# Recorded vectors are only for reproducible offline contract tests.
REPOMIND_EMBEDDING_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
REPOMIND_EMBEDDING_API_KEY=
REPOMIND_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
REPOMIND_EMBEDDING_PROVIDER=dashscope
REPOMIND_EMBEDDING_DIMENSIONS=1024
